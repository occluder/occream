{
    "version": "0.4.10",
    "description": "Discover, download, and run local LLMs",
    "homepage": "https://lmstudio.ai/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://lmstudio.ai/terms"
    },
    "architecture": {
        "64bit": {
            "url": "https://installers.lmstudio.ai/win32/x64/0.4.10-1/LM-Studio-0.4.10-1-x64.exe#/dl.7z",
            "hash": "ea5e6a690a4d2e734b9d6a0858863af1cca5e093cd0a53e91efd0b968231a001",
            "installer": {
                "script": [
                    "# Extract the archive into a temporary folder",
                    "Expand-7zipArchive \"$dir\\dl.7z\" \"$dir\\tmp\"",
                    "# Move everything from the $PLUGINSDIR folder to the app root",
                    "Move-Item \"$dir\\tmp\\$PLUGINSDIR\\*\" \"$dir\\\" -Force",
                    "# Remove the temporary folder and the original archive",
                    "Remove-Item \"$dir\\tmp\" -Recurse -Force",
                    "Remove-Item \"$dir\\dl.7z\" -Force",
                    "# Now extract the inner app-64.7z (or app-arm64.7z)",
                    "$innerArchive = if ($architecture -eq '64bit') { 'app-64.7z' } else { 'app-arm64.7z' }",
                    "Expand-7zipArchive \"$dir\\$innerArchive\" \"$dir\"",
                    "Remove-Item \"$dir\\$innerArchive\" -Force"
                ]
            }
        },
        "arm64": {
            "url": "https://installers.lmstudio.ai/win32/arm64/0.4.10-1/LM-Studio-0.4.10-1-arm64.exe#/dl.7z",
            "hash": "297a287c78e1c4c14227520a7cbc72f75310c4064433fa234ecc72ed99e50f9e",
            "installer": {
                "script": [
                    "Expand-7zipArchive \"$dir\\dl.7z\" \"$dir\\tmp\"",
                    "Move-Item \"$dir\\tmp\\$PLUGINSDIR\\*\" \"$dir\\\" -Force",
                    "Remove-Item \"$dir\\tmp\" -Recurse -Force",
                    "Remove-Item \"$dir\\dl.7z\" -Force",
                    "$innerArchive = 'app-arm64.7z'",
                    "Expand-7zipArchive \"$dir\\$innerArchive\" \"$dir\"",
                    "Remove-Item \"$dir\\$innerArchive\" -Force"
                ]
            }
        }
    },
    "bin": "resources\\app\\.webpack\\lms.exe",
    "shortcuts": [
        [
            "LM Studio.exe",
            "LM Studio"
        ]
    ],
    "checkver": {
        "regex": "\\\\\"title\\\\\"\\s*:\\s*\\\\\"Windows\\\\\"\\s*,\\s*\\\\\"subtitle\\\\\"\\s*:\\s*\\\\\"([\\d.]+)\\\\\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://installers.lmstudio.ai/win32/x64/$version-1/LM-Studio-$version-1-x64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://installers.lmstudio.ai/win32/arm64/$version-1/LM-Studio-$version-1-arm64.exe#/dl.7z"
            }
        }
    }
}
